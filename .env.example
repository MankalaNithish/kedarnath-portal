# Existing
MONGODB_URI=mongodb://localhost:27017/kedarnath
PORT=3002

# Firebase web config for the reviews feed.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup.
# These are public identifiers, not secrets; firestore.rules is what protects the data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin credentials for the Gallery & News management portal (/admin).
# .env IS COMMITTED and must hold safe defaults only — the historical login
# pair below is intentional (it already lives in the legacy login page code).
# Real production secrets go in .env.local (git-ignored), which overrides .env.
# The password is seeded as a scrypt hash into MongoDB on server boot.
ADMIN_USERNAME=kedarnathadmin
ADMIN_PASSWORD=adminkedar3456
# Secret that signs the admin session cookie. Generate with: openssl rand -hex 32
# Put the real value in .env.local, never in the committed .env.
ADMIN_SESSION_SECRET=
