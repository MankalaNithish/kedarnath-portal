MONGODB_URI="mongodb://localhost:27017/kedarnath"
PORT=3002

# Admin credentials for the Gallery & News management portal (/admin).
# Defaults match the historical login. The password is seeded into the users
# collection as a scrypt hash on server boot; override before deploying.
ADMIN_USERNAME=kedarnathadmin
ADMIN_PASSWORD=adminkedar3456
# Secret that signs the admin session cookie. Change in production.
ADMIN_SESSION_SECRET=kedarnath-portal-dev-secret-change-me