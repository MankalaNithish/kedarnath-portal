# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — .env IS committed (safe defaults only); real secrets go in
# .env.local, which git ignores. Never put real passwords/keys in .env.
.env*.local

# vercel
.vercel

package-lock.json
.gstack/

# firebase emulator
*-debug.log
.firebase/
